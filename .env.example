# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 和 .dockerignore 忽略，不要提交，也不要打进镜像。

# OpenAI 或兼容端点
OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# 与端点支持的模型名一致；代码会自动补 openai: 前缀
OPENAI_MODEL=gpt-4.1-mini
# 课程 lab 用 DeepSeek 时可改为：
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-flash
# writer 单次输出上限（默认 32000）。推理模型的隐藏推理 token 也计入该额度；
# 输出被截断时会自动续写，正文为空时加倍额度重试。
# OPENAI_MAX_TOKENS=32000

# Tavily 搜索
TAVILY_API_KEY=your-tavily-api-key
# 可选：覆盖 Tavily 端点
# DLAI_TAVILY_BASE_URL=

# 数据库：Docker 入口脚本会用下面的 POSTGRES_* 生成 DSN；
# 本地非 Docker 运行时可直接用 SQLite。
# POSTGRES_PASSWORD 必须设置（入口脚本不再提供默认口令）。
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=appdb
# DATABASE_URL=postgresql://app:change-me@127.0.0.1:5432/appdb
# DATABASE_URL=sqlite:///E:/path/to/research_agent_debug.db
# 设为 1 时启动清空 tasks 表；默认保留历史任务
# RESET_DB_ON_STARTUP=1

# --- 运行安全配置 ---
# 默认必须设置 APP_API_KEY；未设置时应用会拒绝启动。
# 仅本地开发/演示可以显式设置 ALLOW_ANONYMOUS=1。
# APP_API_KEY=change-me-to-a-long-random-string
# ALLOW_ANONYMOUS=1
# 单次提示词最大字符数（默认 4000）
# MAX_PROMPT_CHARS=4000
# 每个 IP（IPv6 按 /64 聚合）每分钟最多发起多少次报告生成（默认 5）
# RATE_LIMIT_PER_MINUTE=5
# 限流桶数量上限（默认 10000；超过后按最近使用时间淘汰）
# MAX_RATE_BUCKETS=10000
# 同时存在（运行中 + 排队）的任务上限（默认 10）
# MAX_ACTIVE_TASKS=10
# 同时调用 LLM 的任务上限（默认 2）
# MAX_CONCURRENT_TASKS=2
# 允许跨域访问的来源，逗号分隔；留空 = 只允许同源
# CORS_ALLOW_ORIGINS=
